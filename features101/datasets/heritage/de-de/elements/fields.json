{
    "title":"SQL: Heimische Verbreitung",
    "category":"demonstrations-de-de",
    "name":"sql-de-de",
    "label":"SQL: Heimische Verbreitung",
    "default_value":"",
    "context":"com_content.article",
    "type":"sql",
    "description":"<p>Wählen Sie einen oder mehrere Kontinente aus, auf denen diese Art heimisch ist.</p>",
    "note":"",
    "state":0,
    "language":"de-DE",
    "params":{
        "showlabel":"1"
    },
    "fieldparams":{
        "query":"SELECT a.alias AS value, a.title AS text \r\nFROM `lje7b_categories` AS `a` \r\nLEFT JOIN `lje7b_languages` AS `l` ON `l`.`lang_code` = `a`.`language` \r\nWHERE `a`.`path` \r\nLIKE 'heritage-%\/%' AND `l`.`lang_code` = 'de-DE' \r\nORDER BY a.lft; ","header":"- Select Continent -","multiple":1
    },
    "created_time":"NOW()",
    "modified_time":"NOW()",
    "id":0,
    "parent_fieldgroup":"Demonstrationen"
