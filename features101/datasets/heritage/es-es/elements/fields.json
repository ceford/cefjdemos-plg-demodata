{
    "title":"SQL: distribución autóctona",
    "category":"demonstrations-es-es",
    "name":"sql-es-es",
    "label":"SQL: distribución autóctona",
    "default_value":"",
    "context":"com_content.article",
    "type":"sql",
    "description":"<p>Seleccione uno o más continentes donde esta especie sea autóctona.</p>",
    "note":"",
    "state":0,
    "language":"es-ES",
    "params":{
        "showlabel":"1"
    },
    "fieldparams":{
        "query":"SELECT a.alias AS value, a.title AS text \r\nFROM `lje7b_categories` AS `a` \r\nLEFT JOIN `lje7b_languages` AS `l` ON `l`.`lang_code` = `a`.`language` \r\nWHERE `a`.`path` \r\nLIKE 'heritage-%\/%' AND `l`.`lang_code` = 'es-ES' \r\nORDER BY a.lft; ","header":"- Select Continent -","multiple":1
    },
    "created_time":"NOW()",
    "modified_time":"NOW()",
    "id":0,
    "parent_fieldgroup":"Demostraciones"
