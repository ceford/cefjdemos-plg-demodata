    "language":"en-GB",
    "params":{
        "showlabel":"1"
    },
    "fieldparams":{
        "query":"SELECT a.alias AS value, a.title AS text \r\nFROM `un81r_categories` AS `a` \r\nLEFT JOIN `un81r_languages` AS `l` ON `l`.`lang_code` = `a`.`language` \r\nWHERE `a`.`path` \r\nLIKE 'heritage-%\/%' AND `l`.`lang_code` = 'en-GB' \r\nORDER BY a.lft; ","header":"- Select Continent -","multiple":1
